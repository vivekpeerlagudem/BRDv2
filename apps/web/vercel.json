{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-RENDER-API-HOST/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://REPLACE-WITH-RENDER-API-HOST/auth/:path*" },
    { "source": "/public/:path*", "destination": "https://REPLACE-WITH-RENDER-API-HOST/public/:path*" },
    { "source": "/p", "has": [{ "type": "host", "value": "REPLACE-WITH-BUYER-DOMAIN" }], "destination": "/buyer.html" },
    { "source": "/f", "has": [{ "type": "host", "value": "REPLACE-WITH-BUYER-DOMAIN" }], "destination": "/buyer.html" },
    { "source": "/((?!api/|auth/|public/|assets/).*)", "destination": "/index.html" }
  ]
}
