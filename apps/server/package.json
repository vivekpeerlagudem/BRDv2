{
  "name": "@crm/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:check": "tsx src/cli/db-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/cli/seed.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@crm/proposal": "workspace:*",
    "@crm/shared": "workspace:*",
    "@hono/node-server": "2.1.9",
    "better-auth": "1.7.25",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
