{
  "name": "sales-crm",
  "private": true,
  "description": "Internal Sales CRM \u00e2\u20ac\u201d modular monolith (see docs/README.md)",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter @crm/server dev",
    "dev:web": "pnpm --filter @crm/web dev",
    "db:check": "pnpm --filter @crm/server db:check",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @crm/server db:migrate",
    "db:seed": "pnpm --filter @crm/server db:seed",
    "dev:worker": "pnpm --filter @crm/server worker",
    "test:e2e": "playwright test",
    "pretest": "pnpm --filter @crm/server db:migrate --test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
