# Copy to .env.local (never committed) and fill in values. See LOCAL-SETUP.md.
# Real passwords and secrets go ONLY in .env.local.

# --- Core ---
NODE_ENV=development
PROCESS_ROLE=server
PORT=3000
LOG_LEVEL=info
# Internal web app and the separate buyer-facing origin (Vite serves both in development).
APP_ORIGIN=http://localhost:5273
BUYER_ORIGIN=http://proposals.localhost:5273

# --- Database (PostgreSQL 18, native) ---
# Application role: data access only, cannot change the schema or edit the audit log.
DATABASE_URL=postgres://crm_app:CHANGE_ME@localhost:5432/crm_dev
# Migration role: owns the schema; used only by `pnpm db:migrate`.
DATABASE_URL_MIGRATOR=postgres://crm_migrator:CHANGE_ME@localhost:5432/crm_dev
# Separate database for automated tests (`pnpm test` migrates it automatically).
TEST_DATABASE_URL=postgres://crm_app:CHANGE_ME@localhost:5432/crm_test
TEST_DATABASE_URL_MIGRATOR=postgres://crm_migrator:CHANGE_ME@localhost:5432/crm_test
DB_POOL_MAX=10

# --- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
BETTER_AUTH_SECRET=CHANGE_ME_64_HEX
# Encrypts stored share-link tokens. Development only; production must use a managed key service.
KEYRING_LOCAL_MASTER_KEY=CHANGE_ME_64_HEX
ESIGN_WEBHOOK_SECRET=CHANGE_ME_RANDOM

# --- Adapters (all simulated locally; nothing leaves this machine) ---
STORAGE_DIR=./.data/storage
# fake = built-in simulator (NOT legally valid). A real provider is an open decision (OD-03).
ESIGN_PROVIDER=fake
# fake = built-in deterministic mock (no network, no cost).
# anthropic = real model: also set ANTHROPIC_API_KEY. This makes PAID calls — get the owner's approval first.
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=
# Optional overrides (defaults shown):
# AI_MODEL_DRAFT=claude-sonnet-5-5
# AI_MODEL_SUMMARY=claude-sonnet-5-5
# AI_MODEL_FOLLOW_UP=claude-sonnet-5-5
# AI_MODEL_REWRITE=claude-haiku-5-5
# AI_MODEL_REVIEW=claude-opus-5-5
# AI_MODEL_WEEKLY=claude-sonnet-5-5
# AI_TIMEOUT_MS=90000
# AI_MAX_ATTEMPTS=2
# AI_RETRY_DELAY_MS=1000
# AI_RATE_PER_MINUTE=20
# log = emails are written to the server log and never sent.
TXEMAIL_PROVIDER=log

# SEED_PASSWORD is appended automatically by `pnpm db:seed` (demo users' password).
